# Database
DATABASE_URL=postgres://user:password@localhost:5432/rab?sslmode=disable

# JWT
JWT_SECRET=your-secret-key-here

# Server
SERVER_PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# Auction Settings
AUCTION_DURATION_HOURS=24
MAX_BIDS_PER_AUCTION=10
MAX_ACTIVE_BIDS_PER_USER=3
SELECTION_WINDOW_HOURS=24
MAX_CANCELLATIONS_PER_MONTH=3
MIN_INTERESTS_AT_REGISTRATION=5
MAX_NOTIFICATIONS_PER_USER=10

# Firebase (for notifications)
FIREBASE_CREDENTIALS_PATH=

# Email (Gmail SMTP)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Seeding — generates demo listings hourly. Set false to stop them.
SEED_ENABLED=true

# Require business documents during onboarding. Off by default: the manual
# subscription grant is the real checkpoint, not document review.
REQUIRE_DOCUMENTS=false

# Restrict the feed to the viewer's governorate, and scope new-listing
# notifications the same way. Off by default: enabling it splits the
# marketplace across 27 governorates.
REGION_FILTER_ENABLED=false

# Posts wait for an admin to approve them before going live. On by default —
# set false to publish immediately, which is also the instant off switch if the
# review queue backs up.
POST_APPROVAL_ENABLED=true

# Upload
MAX_UPLOAD_SIZE_MB=10
